    <!-- Form & Interactions Logic -->
    <script>
        // Wrap all script in DOMContentLoaded to ensure DOM is ready
        document.addEventListener('DOMContentLoaded', function() {
            // --- 1. Dark Mode Toggle ---
            const darkModeToggle = document.getElementById('darkModeToggle');
            const darkIcon = document.getElementById('darkIcon');

            function applyTheme(isDark) {
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    darkIcon.textContent = 'dark_mode';
                } else {
                    document.documentElement.classList.remove('dark');
                    darkIcon.textContent = 'light_mode';
                }
            }

            // Initialize theme preference
            const savedTheme = localStorage.getItem('darkMode');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            let isDarkActive = savedTheme === 'true' || (savedTheme === null && systemPrefersDark);
            applyTheme(isDarkActive);

            darkModeToggle.addEventListener('click', () => {
                isDarkActive = !isDarkActive;
                localStorage.setItem('darkMode', isDarkActive);
                applyTheme(isDarkActive);
            });

            // --- 2. Password Visibility Toggle ---
        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('eyeIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.textContent = 'visibility_off';
            } else {
                passwordInput.type = 'password';
                eyeIcon.textContent = 'visibility';
            }
        }

        window.togglePassword = togglePassword;

        // --- 3. Modal Interactions (Help) ---
        const helpBtn = document.getElementById('helpBtn');
        const helpModal = document.getElementById('helpModal');
        const helpCloseBtn = document.getElementById('helpCloseBtn');

        function openHelpModal() {
            helpModal.classList.remove('hidden');
            helpModal.classList.add('flex');
        }

        function closeHelpModal() {
            helpModal.classList.remove('flex');
            helpModal.classList.add('hidden');
        }

        helpBtn.addEventListener('click', openHelpModal);
        helpCloseBtn.addEventListener('click', closeHelpModal);

        // Close on clicking backdrop
        helpModal.addEventListener('click', (e) => {
            if (e.target === helpModal) {
                closeHelpModal();
            }
        });

        // Close on pressing Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !helpModal.classList.contains('hidden')) {
                closeHelpModal();
            }
        });

        // --- 5. Form Submissions Interceptor (Modern Errors & Spinner) ---
        const errorAlert = document.getElementById('errorAlert');
        const errorAlertText = document.getElementById('errorAlertText');
        const successAlert = document.getElementById('successAlert');
        const submitBtn = document.getElementById('submitBtn');
        const btnSpinner = document.getElementById('btnSpinner');
        const btnText = document.getElementById('btnText');

        function showErrorAlert(message) {
            errorAlertText.textContent = message;
            errorAlert.classList.remove('hidden');
            errorAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function closeErrorAlert() {
            errorAlert.classList.add('hidden');
        }

        function showSuccessAlert() {
            successAlert.classList.remove('hidden');
        }

        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            closeErrorAlert();

            // Client-side validations
            const role = roleInput.value;
            const tipe = typeInput.value;

            if (tipe === 'siswa') {
                // Validasi Siswa Pembeli
                const userInput = document.getElementById('userInput').value.trim();
                const passwordVal = document.getElementById('passwordInput').value;
                const kelasSelect = document.getElementById('kelasSelect');

                if (!userInput) {
                    showErrorAlert('Username atau Email tidak boleh kosong.');
                    return;
                }
                if (!passwordVal) {
                    showErrorAlert('Password tidak boleh kosong.');
                    return;
                }
                if (!kelasSelect.value) {
                    showErrorAlert('Silakan pilih kelas Anda terlebih dahulu.');
                    return;
                }
            } else if (tipe === 'guru') {
                // Validasi Guru - Using Guru Fields
                const guruUserInput = document.getElementById('guruUserInput').value.trim();
                const guruPasswordInput = document.getElementById('guruPasswordInput').value;

                if (!guruUserInput) {
                    showErrorAlert('Username atau Email tidak boleh kosong.');
                    return;
                }
                if (!guruPasswordInput) {
                    showErrorAlert('Password tidak boleh kosong.');
                    return;
                }

                // Copy Guru input values to hidden siswa fields for form submission
                document.getElementById('userInput').value = guruUserInput;
                document.getElementById('passwordInput').value = guruPasswordInput;
            }

            // Start Loading State
            submitBtn.disabled = true;
            btnSpinner.classList.remove('hidden');
            btnText.textContent = 'Memverifikasi...';

            try {
                // Post form data to current action
                const formData = new FormData(loginForm);
                const response = await fetch(loginForm.action, {
                    method: 'POST',
                    body: formData
                });

                // Check if redirect already occurred
                if (response.redirected) {
                    showSuccessAlert();
                    setTimeout(() => {
                        window.location.href = response.url;
                    }, 800);
                    return;
                }

                const responseText = await response.text();

                // Check if the response contains alert scripts outputted by backend
                const alertRegex = /alert\(['"]([^'"]+)['"]\)/;
                const match = responseText.match(alertRegex);

                if (match && match[1]) {
                    // Extract message and display as modern inline alert
                    showErrorAlert(match[1]);
                    
                    // Reset Button State
                    submitBtn.disabled = false;
                    btnSpinner.classList.add('hidden');
                    btnText.textContent = 'Masuk Akun';
                } else {
                    // If no alert is found, but the response went through successfully
                    if (response.url && !response.url.includes('login.php')) {
                        showSuccessAlert();
                        setTimeout(() => {
                            window.location.href = response.url;
                        }, 800);
                    } else {
                        // Fallback: standard submission
                        showSuccessAlert();
                        setTimeout(() => {
                            loginForm.submit();
                        }, 500);
                    }
                }
            } catch (err) {
                console.error(err);
                showErrorAlert('Terjadi kesalahan jaringan atau server. Silakan coba lagi.');
                
                // Reset Button State
                submitBtn.disabled = false;
                btnSpinner.classList.add('hidden');
                btnText.textContent = 'Masuk Akun';
            }
        });
        }); // End DOMContentLoaded event listener
    </script>
</body>
</html>